<?xml version="1.0" encoding="UTF-8"?>
<!--
  FROTA CTL — Configuração IIS (ASP.NET)
  ========================================
  Pré-requisitos no servidor:
    1. IIS com ASP.NET 4.x habilitado (Painel de Controle → Programas →
       Ativar ou desativar recursos do Windows → IIS → Recursos HTTP +
       Serviços de Aplicativos → ASP.NET 4.x).
    2. SQL Server Express 2025 instalado no mesmo servidor (ou acessível pela
       rede), com o banco FrotaCTL criado e a connection string abaixo
       preenchida. Veja o passo a passo completo em MANUAL.md.
       (A antiga exigência de permissão de escrita na pasta /data/ não existe
       mais — os dados agora ficam no SQL Server, não em arquivo.)
-->
<configuration>
  <!--
    ── Banco de dados (SQL Server Express 2025) ────────────────────────────
    Ajuste "Server" para o nome da instância do seu SQL Express (geralmente
    "NOMEDOSERVIDOR\SQLEXPRESS" ou apenas ".\SQLEXPRESS" se for local).

    Opção A — Autenticação do Windows (recomendada, sem senha no arquivo):
      o "pool de aplicativos" do IIS precisa ter um login criado no SQL
      Server com permissão na tabela dbo.FrotaDB (ver MANUAL.md).

    Opção B — Autenticação SQL (usuário e senha):
      troque "Trusted_Connection=True" por "User Id=SEU_USUARIO;Password=SUA_SENHA;"
  -->
<connectionStrings>
  <!-- Exemplo com Autenticacao do Windows (recomendado, sem senha no arquivo) -->
  <add name="FrotaCTL"
       connectionString="Server=.\SQLEXPRESS;Database=FrotaCTL;Trusted_Connection=True;TrustServerCertificate=True;"
       providerName="System.Data.SqlClient" />
  <!-- Alternativa com usuario/senha do SQL Server (Opcao B do MANUAL.md):
  <add name="FrotaCTL"
       connectionString="Server=NOME_DO_SERVIDOR\SQLEXPRESS;Database=FrotaCTL;User Id=SEU_USUARIO;Password=SUA_SENHA_AQUI;TrustServerCertificate=True;"
       providerName="System.Data.SqlClient" />
  -->
</connectionStrings>

  <!--
    ── Notificações de Troca de Óleo (OilAlerts.ashx) ──────────────────────
    Preencha com os dados da sua conta Twilio (https://www.twilio.com/console).
    NotifSecret é opcional, mas recomendado: uma chave qualquer que você
    inventa e usa na URL da Tarefa Agendada (ex: OilAlerts.ashx?key=SUACHAVE),
    para impedir que outras pessoas disparem SMS usando sua conta.
    Veja o passo a passo completo em MANUAL.md.
  -->
  <appSettings>
    <add key="TwilioAccountSid"  value="" />
    <add key="TwilioAuthToken"   value="" />
    <add key="TwilioFromNumber"  value="" />
    <add key="NotifSecret"       value="" />
  </appSettings>

  <system.web>
    <!-- Define o pipeline de execução como Integrated (padrão no IIS 7+) -->
    <!-- debug="false" é o padrão recomendado em produção. Troque para "true"
         apenas temporariamente, ao investigar um erro. -->
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="16384" />
    <!-- customErrors="Off" exibe a mensagem de erro detalhada (útil ao configurar
         o sistema pela primeira vez). Depois de validar que tudo funciona,
         troque para mode="RemoteOnly" (ou "On") para não expor detalhes técnicos
         a quem acessar pelo navegador. -->
    <customErrors mode="Off" />
  </system.web>

  <system.webServer>

    <!-- ── Documento padrão ─────────────────────────────────────────── -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ── Proteção da pasta /data ──────────────────────────────────── -->
    <!-- Impede acesso direto pelo navegador ao arquivo JSON com os dados -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="data" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ── Cache de arquivos estáticos ──────────────────────────────── -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      <!-- Evita cache do app.js durante desenvolvimento (remova em produção) -->
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <!-- MIME type das fontes locais (fonts/*.woff2) — sem isso o IIS
           recusa servir o arquivo (erro 404.3) e o navegador cai na fonte
           padrão do sistema, deixando o layout com aparência genérica -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- ── Compressão ───────────────────────────────────────────────── -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- ── Cabeçalhos de segurança ──────────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
